  91   1          lcd_cmd(0x01);
  92   1      
  93   1          delay(2);
  94   1      }
  95          
  96          void lcd_puts(char *str)
  97          {
  98   1          while(*str)
  99   1          {
 100   2              lcd_data(*str);
 101   2              str++;
 102   2          }
 103   1      }
 104          
 105          void main()
